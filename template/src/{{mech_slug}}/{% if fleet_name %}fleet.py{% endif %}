"""This Mech's Fleet canon: the shared files, checked against fleet/pin.yaml.

    python -m <slug>.fleet            # offline: each shared file matches its sha256 in the pin
    python -m <slug>.fleet --online   # also: the pin matches the Coordinator on GitHub, at its ref

The Coordinator owns these files. It writes them and the pin with `fleet sync`;
an update from mechmaker leaves them alone. A mismatch offline means a local
edit: undo it, and make the change in the Coordinator instead.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import sys
import urllib.request

import yaml

from .paths import REPO_ROOT

PIN = REPO_ROOT / "fleet" / "pin.yaml"
RAW = "https://raw.githubusercontent.com/{coordinator}/{ref}/canon/manifest.yaml"


def read_pin() -> dict:
    data = yaml.safe_load(PIN.read_text()) if PIN.exists() else None
    return data if isinstance(data, dict) else {}


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def offline_errors(pin: dict | None = None) -> list[str]:
    pin = read_pin() if pin is None else pin
    if not pin:
        return [f"{PIN.relative_to(REPO_ROOT)} is missing or empty"]
    errors = []
    for art in pin.get("artifacts") or []:
        path = REPO_ROOT / art["target"]
        if not path.exists():
            errors.append(f"{art['target']} is missing")
        elif sha256(path.read_bytes()) != art["sha256"]:
            errors.append(f"{art['target']} differs from the Fleet canon in fleet/pin.yaml. Undo the local "
                          "edit; change it in the Coordinator and sync it here.")
    return errors


def online_errors(pin: dict) -> list[str]:
    ref, coordinator = str(pin.get("ref") or ""), str(pin.get("coordinator") or "")
    if len(ref) != 40:
        return [f"not synced yet: ask the Coordinator ({coordinator}) to run `fleet sync`"]
    request = urllib.request.Request(RAW.format(coordinator=coordinator, ref=ref))
    if os.environ.get("GITHUB_TOKEN"):  # a private Coordinator
        request.add_header("Authorization", f"Bearer {os.environ['GITHUB_TOKEN']}")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            manifest = yaml.safe_load(response.read()) or {}
    except OSError as exc:
        return [f"could not read the Coordinator's manifest at {ref[:12]}: {exc}"]
    pinned = {a.get("id"): a for a in pin.get("artifacts") or []}
    errors = []
    for art in manifest.get("artifacts") or []:
        mine = pinned.get(art["id"])
        if mine is None:
            errors.append(f"the canon at {ref[:12]} has {art['id']}, which fleet/pin.yaml lacks")
        elif mine.get("sha256") != art["sha256"]:
            errors.append(f"fleet/pin.yaml's sha256 for {art['id']} is not the canon's at {ref[:12]}")
    return errors


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--online", action="store_true", help="also check the pin against the Coordinator")
    args = parser.parse_args(argv)
    pin = read_pin()
    errors = offline_errors(pin)
    if args.online and pin:
        errors += online_errors(pin)
    for e in errors:
        print(f"ERROR {e}")
    if errors:
        return 1
    ref = str(pin.get("ref") or "")
    print(f"Fleet canon: matches fleet/pin.yaml ({'at ' + ref[:12] if ref else 'not synced yet'}).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
