[project]
name = "{{ mech_slug }}"
version = "0.1.0"
description = "{{ description | replace('"', '\\"') }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
readme = "README.md"
license = { text = "{{ code_license }}" }
requires-python = ">={{ python_min }}"
keywords = ["mech", "knowledge base", "linkml", "ontology", "curation"]

dependencies = [
    "linkml>=1.11.1",
    "linkml-runtime>=1.9.4",
    # Checks that every bound CURIE exists, sits under its enum root, and
    # carries the ontology's own label.
    "linkml-term-validator>=0.4.5",
    # Checks that every snippet appears verbatim in its cited source.
    "linkml-reference-validator>=0.2.1",
    "oaklib>=0.7.3",
    # oaklib imports eutils, which still imports pkg_resources.
    "setuptools<82",
    "pyyaml>=6.0",
    # Edits records in place with their layout kept (just add-evidence).
    "ruamel.yaml>=0.18",
    "jinja2>=3.1",
{%- if 'duckdb' in output_formats %}
    # The DuckDB export (duckdb in conf/export.yaml). Only here because this
    # Mech exports DuckDB: linkml-store brings many packages of its own.
    "linkml-store>=0.3.2",
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.6",
    # The documentation site. MkDocs 2 drops the plugin and theme system
    # Material relies on, so stay on 1.x.
    "mkdocs>=1.6,<2",
    "mkdocs-material>=9.7",
]

[project.urls]
Homepage = "https://github.com/{{ github_org }}/{{ repo_name }}"
Repository = "https://github.com/{{ github_org }}/{{ repo_name }}"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ mech_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src", "."]

[tool.ruff]
line-length = 110
target-version = "py{{ python_min | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM"]
