# Label each new issue. The agent only reads and returns label names; a
# second job with no model applies the ones that exist. Anyone can open an
# issue, so the agent that reads it has no write access at all, and it may
# choose only from a fixed list. `curation` hands an issue to the curation
# scanner, which can push, so it goes on only when the issue's author has
# write access to the repository; on anyone else's issue a person adds it.
name: Triage

on:
  issues:
    types: [opened]
  workflow_dispatch:
    inputs:
      issue_number:
        description: Issue to label
        required: true
        type: string
{% raw %}
permissions: {}

concurrency:
  group: triage-${{ github.event.issue.number || inputs.issue_number }}
  cancel-in-progress: false

jobs:
  choose:
    if: github.event_name == 'workflow_dispatch' || github.event.issue.user.type != 'Bot'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      issues: read
    outputs:
      result: ${{ steps.run.outputs.structured_output }}
      number: ${{ steps.num.outputs.number }}
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - id: num
        env:
          N: ${{ github.event.issue.number || inputs.issue_number }}
        run: |
          [[ "$N" =~ ^[1-9][0-9]*$ ]] || { echo "::error::bad issue number"; exit 1; }
          echo "number=$N" >> "$GITHUB_OUTPUT"
      - name: Build prompt
        id: prompt
        env:
          PROMPT_REPO: ${{ github.repository }}
          PROMPT_ISSUE_NUMBER: ${{ steps.num.outputs.number }}
        run: python3 .github/scripts/render_prompt.py triage
      - id: agent
        uses: ./.github/actions/setup-agent
        with:
          workflow: triage
          install-project: "false"
      - id: run
        uses: anthropics/claude-code-action@fd1c128679612beff4ca259c78021c506e8aa7a7 # v1.0.237
        env:
          GH_TOKEN: ${{ github.token }}
{% endraw %}{% if langfuse %}          LANGFUSE_PUBLIC_KEY: ${{ '{{' }} secrets.LANGFUSE_PUBLIC_KEY {{ '}}' }}
          LANGFUSE_SECRET_KEY: ${{ '{{' }} secrets.LANGFUSE_SECRET_KEY {{ '}}' }}
          LANGFUSE_BASE_URL: ${{ '{{' }} secrets.LANGFUSE_BASE_URL {{ '}}' }}
          CC_LANGFUSE_TRACE_TAGS: >-
            ["repo:${{ '{{' }} github.repository {{ '}}' }}", "workflow:triage",
            "run:${{ '{{' }} github.run_id {{ '}}' }}", "job:${{ '{{' }} github.job {{ '}}' }}"]
{% endif %}{% raw %}        with:
          # The API key is preferred: it has no weekly cap. The subscription
          # token is used only when no API key is set.
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          claude_code_oauth_token: ${{ secrets.ANTHROPIC_API_KEY == '' && secrets.CLAUDE_CODE_OAUTH_TOKEN || '' }}
          path_to_claude_code_executable: ${{ steps.agent.outputs.executable }}
          github_token: ${{ github.token }}
          # Safe only because this job cannot write.
          allowed_non_write_users: "*"
          prompt: ${{ steps.prompt.outputs.prompt }}
{% endraw %}{% if langfuse %}          plugin_marketplaces: |
            https://github.com/langfuse/Claude-Observability-Plugin.git
          plugins: |
            langfuse-observability@langfuse-observability
{% endif %}{% raw %}          claude_args: |
            --model ${{ steps.agent.outputs.model }}
            --max-turns ${{ steps.agent.outputs.max-turns }}
            --allowedTools "Bash(gh issue view:*)"
            --json-schema '{"type":"object","properties":{"labels":{"type":"array","maxItems":6,"items":{"enum":["curation","low_effort","medium_effort","high_effort","schema","bug","enhancement","question","documentation","high-priority","low-priority"]}}},"required":["labels"],"additionalProperties":false}'
      - name: Check the agent run
        if: always() && steps.agent.outcome == 'success'
        env:
          EXECUTION_FILE: ${{ steps.run.outputs.execution_file }}
        run: python3 .github/scripts/check_agent_run.py "$EXECUTION_FILE" "Triage"

  apply:
    needs: choose
    if: needs.choose.outputs.result != ''
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      issues: write
    steps:
      - uses: actions/github-script@v9
        env:
          RESULT: ${{ needs.choose.outputs.result }}
          NUMBER: ${{ needs.choose.outputs.number }}
        with:
          script: |
            // The agent's schema already limits it to these; check again here.
            const ALLOWED = new Set(['curation', 'low_effort', 'medium_effort', 'high_effort', 'schema',
              'bug', 'enhancement', 'question', 'documentation', 'high-priority', 'low-priority']);
            const WRITERS = new Set(['OWNER', 'MEMBER', 'COLLABORATOR']);
            const issue_number = Number(process.env.NUMBER);
            let wanted = [...new Set((JSON.parse(process.env.RESULT).labels || []).map(String))];
            const refused = wanted.filter(l => !ALLOWED.has(l));
            if (refused.length) core.warning(`Ignoring labels triage may not apply: ${refused.join(', ')}`);
            wanted = wanted.filter(l => ALLOWED.has(l));
            if (wanted.includes('curation')) {
              const { data: issue } = await github.rest.issues.get({ ...context.repo, issue_number });
              if (!WRITERS.has(issue.author_association)) {
                core.notice(`Not adding curation: @${issue.user.login} (${issue.author_association}) ` +
                  'cannot write to this repository. A person adds it after reading the issue.');
                wanted = wanted.filter(l => l !== 'curation');
              }
            }
            const existing = new Set((await github.paginate(github.rest.issues.listLabelsForRepo,
              { ...context.repo, per_page: 100 })).map(l => l.name));
            const labels = wanted.filter(l => existing.has(l));
            const dropped = wanted.filter(l => !existing.has(l));
            if (dropped.length) core.warning(`Ignoring labels that do not exist: ${dropped.join(', ')}`);
            if (!labels.length) { core.info('No labels to apply.'); return; }
            await github.rest.issues.addLabels({ ...context.repo, issue_number, labels });
            core.info(`Applied: ${labels.join(', ')}`);
{% endraw %}
