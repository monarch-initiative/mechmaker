# Weekly check of the whole corpus against the live ontology services and the
# cited sources. Pull requests check only what they change and read the
# caches first; this finds drift: a term renamed or obsoleted upstream, a
# source that moved. A red run blocks nobody. It says where to look.
name: Sweep

on:
  schedule:
    - cron: "17 6 * * 1"  # Mondays 06:17 UTC
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: sweep
  cancel-in-progress: false

{% if uses_bioportal or fleet_name -%}
{% if uses_bioportal -%}
# BioPortal terms need a key. Set the repository secret BIOPORTAL_API_KEY.
{% endif -%}
{% if fleet_name -%}
# `just check-fleet --online` reads the Coordinator's canon on GitHub. If the
# Coordinator is private, set the repository secret FLEET_TOKEN to a token
# that can read it.
{% endif -%}
env:
{%- if uses_bioportal %}
  BIOPORTAL_API_KEY: ${{ '{{' }} secrets.BIOPORTAL_API_KEY {{ '}}' }}
{%- endif %}
{%- if fleet_name %}
  FLEET_TOKEN: ${{ '{{' }} secrets.FLEET_TOKEN {{ '}}' }}
{%- endif %}

{% endif -%}
{% raw %}jobs:
  sweep:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          enable-cache: true
      - run: uv tool install rust-just
      - run: just install
      - name: Full check (network)
        run: just qc-full
      - name: Cache changes the sweep would add
        if: always()
        run: git status --short cache references_cache | tee -a "$GITHUB_STEP_SUMMARY"
{%- endraw %}
