# On each published release, bundle the records and attach them: one JSON
# Lines file with every record, and a zip of the YAML files as curated.
name: Release records

on:
  release:
    types: [published]

permissions: {}

env:
  MECH_SLUG: "{{ mech_slug }}"
{% raw %}
jobs:
  bundle:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write  # upload release assets
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
      - run: uv tool install rust-just
      - run: just install
      - name: Check the records before shipping them
        run: just validate-all
      - name: Export, in the formats conf/export.yaml names, and read each file back
        run: just export
      - name: Verify the export is not empty
        run: |
          if [ -z "$(ls -A build/export 2>/dev/null)" ]; then echo "::error::build/export is empty"; exit 1; fi
      - uses: softprops/action-gh-release@v3
        with:
          files: build/export/*
{% endraw %}
