[project]
name = "{{ mech_slug }}"
# The version comes from the latest git tag (v1.2.3); see [tool.uv-dynamic-versioning].
dynamic = ["version"]
description = "{{ description | replace('"', '\\"') }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
readme = "README.md"
license = { text = "{{ code_license }}" }
requires-python = ">={{ python_min }}"
keywords = ["mech", "knowledge base", "linkml", "ontology", "curation"]

dependencies = [
    "linkml>=1.11.1",
    "linkml-runtime>=1.9.4",
    # Checks that every bound CURIE exists, sits under its enum root, and
    # carries the ontology's own label.
    "linkml-term-validator>=0.4.5",
    # Checks that every snippet appears verbatim in its cited source.
    "linkml-reference-validator>=0.2.1",
    "oaklib>=0.7.3",
    # oaklib imports eutils, which still imports pkg_resources.
    "setuptools<82",
    "pyyaml>=6.0",
    # Edits records in place with their layout kept (just add-evidence).
    "ruamel.yaml>=0.18",
    "jinja2>=3.1",
{%- if 'duckdb' in output_formats or load_targets %}
    # linkml-store, for{% if 'duckdb' in output_formats %} the DuckDB export{% endif %}{% if 'duckdb' in output_formats and load_targets %} and{% endif %}{% if load_targets %} `just load` ({{ load_targets | join(', ') }}){% endif %}.
    # Only here because this Mech chose them: it brings many packages of its own.
    "linkml-store{% if load_targets %}[{{ load_targets | join(',') }}]{% endif %}>=0.3.2",
{%- endif %}
{%- if kgx_biolink and ('kgx' in output_formats or 'kgx_maximal' in output_formats) %}
    # The Biolink model, for the KGX exports: they check every category and
    # predicate against it. Only here because this Mech exports KGX.
    "biolink-model>=4.4.5",
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.6",
    # The documentation site. MkDocs 2 drops the plugin and theme system
    # Material relies on, so stay on 1.x.
    "mkdocs>=1.6,<2",
    "mkdocs-material>=9.7",
]

[project.urls]
Homepage = "https://github.com/{{ github_org }}/{{ repo_name }}"
Repository = "https://github.com/{{ github_org }}/{{ repo_name }}"

[build-system]
requires = ["hatchling", "uv-dynamic-versioning>=0.8"]
build-backend = "hatchling.build"

[tool.hatch.version]
source = "uv-dynamic-versioning"

[tool.uv-dynamic-versioning]
# Without a tag, or outside a git checkout, the version is this.
fallback-version = "0.0.0"

[tool.uv]
# Rebuild the installed package when a commit or tag changes its version.
cache-keys = [{ file = "pyproject.toml" }, { git = { commit = true, tags = true } }]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ mech_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src", "."]

[tool.ruff]
line-length = 110
target-version = "py{{ python_min | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM"]
