# Weekly: pull recent papers from Europe PMC that mention this Mech's
# records (conf/literature_scan.yaml sets the query), then let an agent pick
# at most a few of the strongest leads. Anyone can write an abstract, so the
# agent that reads them has no write access: it returns its picks, and a
# second job with no model files them as curation issues, taking the paper's
# details from the packet. Adapted from DisMech's literature, preprint and
# knowledge-gap scans, folded into one.
name: Literature scan

on:
{% if agent_schedules %}  schedule:
    - cron: "0 13 * * 5"  # Fridays 13:00 UTC
{% endif %}  workflow_dispatch:
    inputs:
      source:
        description: MED for PubMed, PPR for preprints
        type: choice
        options: ["MED", "PPR"]
        default: "MED"
      days:
        description: How many days back to search
        type: string
        default: "7"
      max_issues:
        description: Most issues to file
        type: string
        default: "5"
      create_issues:
        description: File issues (off builds the packet only)
        type: boolean
        default: true
{% raw %}
permissions:
  contents: read

concurrency:
  group: literature-scan
  cancel-in-progress: true

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      issues: read
    outputs:
      result: ${{ steps.run.outputs.structured_output }}
    env:
      SOURCE: ${{ inputs.source || 'MED' }}
      PACKET: build/literature/packet.md
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - id: agent
        uses: ./.github/actions/setup-agent
        with:
          workflow: literature-scan
      - name: Build the packet
        env:
          DAYS: ${{ inputs.days || '7' }}
        run: just literature-scan --source "$SOURCE" --days "$DAYS"
      - uses: actions/upload-artifact@v7
        with:
          name: literature-packet
          path: build/literature/
      - name: Build prompt
        id: prompt
        env:
          PROMPT_REPO: ${{ github.repository }}
          PROMPT_MAX_ISSUES: ${{ inputs.max_issues || '5' }}
          PROMPT_SOURCE: ${{ env.SOURCE }}
          PROMPT_PACKET: ${{ env.PACKET }}
        run: python3 .github/scripts/render_prompt.py literature-scan
      - id: run
        if: github.event_name == 'schedule' || inputs.create_issues
        uses: anthropics/claude-code-action@fd1c128679612beff4ca259c78021c506e8aa7a7 # v1.0.237
        env:
          GH_TOKEN: ${{ github.token }}
{% endraw %}{% if langfuse %}          LANGFUSE_PUBLIC_KEY: ${{ '{{' }} secrets.LANGFUSE_PUBLIC_KEY {{ '}}' }}
          LANGFUSE_SECRET_KEY: ${{ '{{' }} secrets.LANGFUSE_SECRET_KEY {{ '}}' }}
          LANGFUSE_BASE_URL: ${{ '{{' }} secrets.LANGFUSE_BASE_URL {{ '}}' }}
          CC_LANGFUSE_TRACE_TAGS: >-
            ["repo:${{ '{{' }} github.repository {{ '}}' }}", "workflow:literature-scan",
            "run:${{ '{{' }} github.run_id {{ '}}' }}", "job:${{ '{{' }} github.job {{ '}}' }}"]
{% endif %}{% raw %}        with:
          # The API key is preferred: it has no weekly cap. The subscription
          # token is used only when no API key is set.
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          claude_code_oauth_token: ${{ secrets.ANTHROPIC_API_KEY == '' && secrets.CLAUDE_CODE_OAUTH_TOKEN || '' }}
          path_to_claude_code_executable: ${{ steps.agent.outputs.executable }}
          github_token: ${{ github.token }}
          prompt: ${{ steps.prompt.outputs.prompt }}
{% endraw %}{% if langfuse %}          plugin_marketplaces: |
            https://github.com/langfuse/Claude-Observability-Plugin.git
          plugins: |
            langfuse-observability@langfuse-observability
{% endif %}{% raw %}          claude_args: |
            --model ${{ steps.agent.outputs.model }}
            --max-turns ${{ steps.agent.outputs.max-turns }}
            --allowedTools "Bash(gh issue list:*),Read,Glob,Grep"
            --json-schema '{"type":"object","properties":{"leads":{"type":"array","maxItems":10,"items":{"type":"object","properties":{"paper":{"type":"string","maxLength":100},"record":{"type":"string","maxLength":300},"name":{"type":"string","maxLength":100},"assessment":{"type":"string","maxLength":4000}},"required":["paper","name","assessment"],"additionalProperties":false}}},"required":["leads"],"additionalProperties":false}'
      - name: Check the agent run
        if: always() && steps.run.outcome != 'skipped' && steps.agent.outcome == 'success'
        env:
          EXECUTION_FILE: ${{ steps.run.outputs.execution_file }}
        run: python3 .github/scripts/check_agent_run.py "$EXECUTION_FILE" "Literature scan"

  publish:
    needs: scan
    if: needs.scan.outputs.result != ''
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
          sparse-checkout: .github/scripts
      - uses: actions/download-artifact@v8
        with:
          name: literature-packet
          path: build/literature
      - uses: actions/github-script@v9
        env:
          RESULT: ${{ needs.scan.outputs.result }}
          MAX_ISSUES: ${{ inputs.max_issues || '5' }}
        with:
          script: |
            const fs = require('fs');
            const { publish } = require('./.github/scripts/literature-publish.js');
            const packet = JSON.parse(fs.readFileSync('build/literature/packet.json', 'utf8'));
            await publish(github, context.repo, JSON.parse(process.env.RESULT), packet, {
              max: Number(process.env.MAX_ISSUES), log: core.info, warn: core.warning,
            });
{% endraw %}
