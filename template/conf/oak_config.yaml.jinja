{%- set cat = ontology_catalog -%}
{%- set adapters = {} -%}
{%- for key in ontologies %}{% if key in cat %}{% set _ = adapters.update({cat[key].prefix: cat[key].adapter}) %}{% endif %}{% endfor -%}
{%- if identity_prefix and identity_prefix not in adapters %}{% set _ = adapters.update({identity_prefix: identity_adapter}) %}{% endif -%}
# OAK adapters for linkml-term-validator, keyed by CURIE prefix.
#
#   ols:<name>         EBI Ontology Lookup Service. Online, nothing to download.
#   sqlite:obo:<name>  Prebuilt SQLite. Offline and fast after a large download.
#   ""                 Skip this prefix on purpose.
#
# Only prefixes listed here are checked. An unlisted prefix is skipped with a
# warning, which means its CURIEs are never checked at all. Add every prefix a
# record can carry. Lookups are cached under cache/ and the cache is committed,
# so routine validation stays offline.

ontology_adapters:
{%- for p, a in adapters | dictsort %}
  {{ p }}: "{{ a }}"
{%- endfor %}
  {{ mech_slug }}: ""
