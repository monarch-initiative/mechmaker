{%- set cat = ontology_catalog -%}
{%- set selected = [] -%}
{%- for key in ontologies %}{% if key in cat %}{% set _ = selected.append(cat[key]) %}{% endif %}{% endfor -%}
{%- set prefixes = {} -%}
{%- for o in selected %}{% set _ = prefixes.update({o.prefix: o.uri}) %}{% endfor -%}
{%- if identity_prefix %}{% set _ = prefixes.update({identity_prefix: identity_uri}) %}{% endif -%}
id: https://w3id.org/{{ github_org }}/{{ mech_slug }}
name: {{ mech_slug }}
title: {{ full_title }}
description: >-
  {{ description }}
license: {{ data_license }}
see_also:
  - https://github.com/{{ github_org }}/{{ repo_name }}

# The starting schema was generated by mechmaker. It is a scaffold, not a
# design. The domain sections below are one per selected ontology and exist so
# the schema validates from the first commit. Reshape them with the
# `extend-schema` skill once the domain model in docs/DOMAIN.md is settled.

prefixes:
  linkml: https://w3id.org/linkml/
  dcterms: http://purl.org/dc/terms/
  skos: http://www.w3.org/2004/02/skos/core#
  rdfs: http://www.w3.org/2000/01/rdf-schema#
  {{ mech_slug }}: https://w3id.org/{{ github_org }}/{{ mech_slug }}/
  PMID: http://www.ncbi.nlm.nih.gov/pubmed/
  DOI: https://doi.org/
{%- for p, u in prefixes | dictsort %}
  {{ p }}: {{ u }}
{%- endfor %}

default_prefix: {{ mech_slug }}
default_range: string

imports:
  - linkml:types
  - mech_shared

# ============================================================ classes

classes:

  {{ record_class }}:
    tree_root: true
    description: >-
      One {{ record_noun }}. The unit of curation, review and history. One
      record lives in one YAML file under {{ records_dir }}/.
    slots:
      - id
      - name
      - description
{%- if identity_prefix %}
      - record_term
{%- endif %}
      - synonyms
      - status
{%- for o in selected %}
      - {{ o.slot }}
{%- endfor %}
{%- if causal_graphs %}
      - mechanisms
{%- endif %}
      - evidence
      - datasets
      - discussions
      - notes
      - creation_date
      - updated_date
      - curation_history
    slot_usage:
      id:
        description: >-
{%- if identity_prefix %}
          The {{ identity_prefix }} CURIE for this {{ record_noun }} where a
          term exists. Otherwise a CURIE minted in the {{ mech_slug }}
          namespace, which can be re-grounded later.
{%- else %}
          A CURIE minted in the {{ mech_slug }} namespace.
{%- endif %}
        pattern: "^[A-Za-z][A-Za-z0-9_]*:[^\\s]+$"
      name:
        required: true
      description:
        recommended: true

  Term:
    description: A reference to an ontology term. The label must match the ontology.
    slots:
      - id
      - label
    slot_usage:
      label:
        required: true

  Descriptor:
    abstract: true
    description: >-
      A curated mention of something, with a human-readable preferred term, an
      optional ontology binding, and evidence. The preferred term may be more
      specific than the bound term when the ontology lacks the needed
      granularity. Never bind a guessed CURIE; leave `term` empty instead.
    slots:
      - preferred_term
      - term
      - description
      - evidence
      - notes
{%- for o in selected %}

  {{ o.descriptor }}:
    is_a: Descriptor
    description: {{ o.article | default('An' if o.noun[0] in 'aeiou' else 'A') }} {{ o.noun }}, bindable to {{ o.prefix }}.
    slot_usage:
      term:
        bindings:
          - binds_value_of: id
            range: {{ o.enum }}
            obligation_level: REQUIRED
{%- endfor %}
{%- if causal_graphs %}

  MechanismNode:
    description: >-
      One step in a causal mechanism graph. Nodes are named uniquely within a
      record; edges point from a node to the names of its downstream nodes.
    slots:
      - name
      - description
{%- for o in selected if o.prefix == 'GO' and o.enum == 'BiologicalProcessTerm' %}
      - biological_processes
{%- endfor %}
      - downstream
      - evidence
      - notes
    slot_usage:
      name:
        required: true
        description: Unique within the record. Edge targets refer to it.

  CausalEdge:
    description: A directed link from the owning node to a downstream node in the same record.
    slots:
      - target
      - description
      - evidence
    slot_usage:
      target:
        required: true
        description: The name of another MechanismNode in the same record.
{%- endif %}

  EvidenceItem:
    description: >-
      A citation that bears on a claim, with a verbatim quote from the source.
      The quote is checked against the cached source text by
      linkml-reference-validator. A paraphrase fails.
    slots:
      - reference
      - reference_title
      - supports
      - evidence_source
      - snippet
      - explanation

  CurationEvent:
    description: >-
      One change to this record, appended and never edited. The repository
      level history/ layer records the session; this records the change on the
      record itself.
    slots:
      - timestamp
      - curator
      - llm_assisted
      - model
      - action
      - description

# ============================================================ slots

slots:
  id:
    identifier: true
    range: uriorcurie
    description: A CURIE.
  name:
    description: Preferred human-readable name.
  label:
    description: >-
      The ontology's own label for the term. Checked by linkml-term-validator.
  description:
    description: Free-text description.
  notes:
    description: Curator notes. Paraphrase belongs here, never in a snippet.
  synonyms:
    multivalued: true
    description: Other names in use.
  status:
    range: CurationStatusEnum
    description: Review state. An agent-drafted record is PROPOSED, never REVIEWED.
{%- if identity_prefix %}
  record_term:
    range: Term
    inlined: true
    recommended: true
    description: The {{ identity_prefix }} term this record is grounded to, with its label.
{%- if identity_root %}
    bindings:
      - binds_value_of: id
        range: IdentityTerm
        obligation_level: REQUIRED
{%- endif %}
{%- endif %}
  preferred_term:
    required: true
    description: The preferred human-readable term for this descriptor.
  term:
    range: Term
    inlined: true
    recommended: true
    description: Ontology term binding. Leave empty rather than guess.
{%- for o in selected %}
  {{ o.slot }}:
    range: {{ o.descriptor }}
    multivalued: true
    inlined_as_list: true
    description: {{ o.noun | capitalize }} mentions for this {{ record_noun }}.
{%- endfor %}
{%- if causal_graphs %}
  mechanisms:
    range: MechanismNode
    multivalued: true
    inlined_as_list: true
    description: The causal mechanism graph for this {{ record_noun }}.
  downstream:
    range: CausalEdge
    multivalued: true
    inlined_as_list: true
    description: Edges from this node to the nodes it causes or enables.
  target:
    description: Name of the target node.
{%- endif %}
  evidence:
    range: EvidenceItem
    multivalued: true
    inlined_as_list: true
    recommended: true
    description: Citations that bear on the enclosing claim.
  datasets:
    range: Dataset
    multivalued: true
    inlined_as_list: true
    description: Public datasets relevant to this record (mech_shared).
  discussions:
    range: Discussion
    multivalued: true
    inlined_as_list: true
    description: Open questions, knowledge gaps and curation to-dos (mech_shared).
  reference:
    description: The cited source, as a CURIE such as PMID:12345678 or DOI:10.1000/xyz.
    pattern: "^[A-Za-z][A-Za-z0-9_]*:[^\\s]+$"
    required: true
    implements:
      - linkml:authoritative_reference
  reference_title:
    description: Title of the cited source. Filled by tooling.
    recommended: true
  supports:
    range: EvidenceSupportEnum
    required: true
    description: Which way the evidence cuts relative to the claim.
  evidence_source:
    range: EvidenceSourceEnum
    description: The kind of system the evidence comes from.
  snippet:
    description: >-
      An exact quote from the cited source. Checked verbatim against the cached
      source text. Paraphrase goes in `explanation`.
    implements:
      - linkml:excerpt
  explanation:
    description: How the quote bears on the claim.
  creation_date:
    range: date
    description: Date the record was created. Stable after first set.
  updated_date:
    range: date
    description: Date of the last substantive change.
  curation_history:
    range: CurationEvent
    multivalued: true
    inlined_as_list: true
    description: Append-only list of changes to this record.
  timestamp:
    range: datetime
    required: true
    description: ISO-8601 time of the change.
  curator:
    required: true
    description: GitHub login of the person, or harness name of the agent.
  llm_assisted:
    range: boolean
    description: True when a model produced or edited the content.
  model:
    description: Model identifier when llm_assisted is true.
  action:
    range: CurationActionEnum
    required: true
    description: What kind of change this was.

# ============================================================ enums

enums:
  CurationStatusEnum:
    description: Review state of a record.
    permissible_values:
      DRAFT:
        description: Incomplete. Not ready for review.
      PROPOSED:
        description: Complete and validated, awaiting human review.
      REVIEWED:
        description: A person reviewed and accepted it. Only a person sets this.
      DEPRECATED:
        description: Kept for provenance. Not current.

  EvidenceSupportEnum:
    description: Direction of an evidence item relative to its claim.
    permissible_values:
      SUPPORT:
        description: The source supports the claim.
      REFUTE:
        description: The source contradicts the claim.
      PARTIAL:
        description: The source supports the claim in part or with caveats.
      NO_EVIDENCE:
        description: The source is relevant but does not bear on the claim.
      WRONG_STATEMENT:
        description: The cited statement was found to be wrong. Kept for provenance.

  EvidenceSourceEnum:
    description: >-
      Where the evidence comes from. Replace or extend these for the domain
      with the `extend-schema` skill.
    permissible_values:
      HUMAN_CLINICAL:
      MODEL_ORGANISM:
      IN_VITRO:
      FIELD_OBSERVATION:
      COMPUTATIONAL:
      OTHER:

  CurationActionEnum:
    description: Kind of change recorded in a CurationEvent.
    permissible_values:
      CREATE:
      EDIT:
      REVIEW:
      DEPRECATE:
{%- if identity_prefix and identity_root %}

  IdentityTerm:
    description: A {{ identity_prefix }} term that can key {{ record_article }} {{ record_noun }}.
    reachable_from:
      source_nodes:
        - {{ identity_root }}
      is_direct: false
      include_self: true
      relationship_types:
        - rdfs:subClassOf
{%- endif %}
{%- for o in selected %}

  {{ o.enum }}:
    description: {{ o.article | default('An' if o.noun[0] in 'aeiou' else 'A') }} {{ o.noun }} term, descending from {{ o.root }} ({{ o.root_label }}).
    reachable_from:
      source_nodes:
        - {{ o.root }}  # {{ o.root_label }}
      is_direct: false
      include_self: true
      relationship_types:
        - rdfs:subClassOf
{%- endfor %}
