# What `just export` writes into build/export/ and checks, and what releases
# attach. `just qc` runs the export, so a format that stops working fails QC.
# The formats and their files are listed in src/{{ mech_slug }}/export.py.
#
# formats: yaml, json, jsonld, ttl, sqlite, duckdb, sql, csv, tsv
#   jsonld and ttl are RDF. Every CURIE in the records becomes an IRI through
#   the schema's `prefixes`, so declare each prefix with its full URI. The
#   export fails on an IRI that does not expand.
# tabular_layout: per_class (one table per class, as in the SQL export) or
#   flat (one row per record, nested values as JSON). Used by csv and tsv.
# kgx, kgx_maximal: a knowledge graph as KGX nodes and edges, mapped onto
#   Biolink in conf/kgx.yaml. They need the biolink-model package.

formats:
{%- for f in output_formats %}
  - {{ f }}
{%- endfor %}
tabular_layout: {{ tabular_layout | default('per_class') }}
