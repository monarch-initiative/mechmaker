@pytest.fixture
def make_member(tmp_path, coordinator, fleet):
    """Make a member's repository: its answers from fleet.yaml, the canon, and these records."""

    def make(member_id: str, records: dict[str, dict] | None = None) -> Path:
        member = fleet.members[member_id]
        root = tmp_path / member_id
        root.mkdir()
        write_yaml(root / ".copier-answers.yml", answers.member_answers(fleet, member))
        for name in ("mech_shared.yaml", "history.yaml"):
            target = root / member.package_path / "schema" / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(coordinator / "canon" / "schema" / name, target)
        for stem, data in (records or {}).items():
            write_yaml(root / member.records_dir / f"{stem}.yaml", data)
        git(root, "init", "-q", "-b", "main")
        commit(root, "the member")
        return root

    return make
