# Weekly: look for new stories about records, in Google News search feeds
# built from each record's words and in the feeds conf/news.yaml names, and
# file what is new as one `news` issue. Anyone can write a news story, so no
# model reads them: `just news-watch` matches items to records by name, and
# this job files the result as it is. Stories in earlier `news` issues are
# skipped, so each is reported once. Leads only: a curator reads the story
# and quotes its archived copy.
name: News watch

on:
  schedule:
    - cron: "41 7 * * 3"  # Wednesdays 07:41 UTC
  workflow_dispatch:
    inputs:
      create_issue:
        description: File the issue (off writes the report only)
        type: boolean
        default: true
{% raw %}
permissions:
  contents: read

concurrency:
  group: news-watch
  cancel-in-progress: false

jobs:
  watch:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          enable-cache: true
      - run: uv tool install rust-just
      - run: just install
      - name: Stories already reported
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir -p build/news
          gh issue list --repo "$GITHUB_REPOSITORY" --label news --state all --limit 200 \
            --json body --jq '.[].body' > build/news/seen.md
      - name: Look for new stories
        run: just news-watch --seen build/news/seen.md
      - uses: actions/upload-artifact@v7
        with:
          name: news-watch
          path: build/news/
          if-no-files-found: ignore
      - name: File the issue
        if: github.event_name == 'schedule' || inputs.create_issue
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if [ ! -f build/news/watch.md ]; then
            echo "No new stories." >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          count=$(python3 -c 'import json; print(json.load(open("build/news/watch.json"))["count"])')
          gh label create news --repo "$GITHUB_REPOSITORY" --color c5def5 \
            --description "Lead from the news watch" --force
          gh issue create --repo "$GITHUB_REPOSITORY" --label news \
            --title "News watch: $count new $([ "$count" = 1 ] && echo story || echo stories), $(date -u +%F)" \
            --body-file build/news/watch.md
{%- endraw %}
