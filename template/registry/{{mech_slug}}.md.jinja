---
# Draft MechRegistry entry. Copy to mech/{{ mech_slug }}/{{ mech_slug }}.md in
# https://github.com/monarch-initiative/mechregistry, update the counts, run
# `uv run mechregistry validate`, and open a pull request. The `register-mech`
# skill in mechmaker does this.
id: {{ mech_slug }}
category: Mech
layout: mech_detail
name: {{ mech_name }}
synonyms:
  - {{ full_title }}
description: >-
  {{ description }}
activity_status: active
maturity: seeded
{%- set site = "https://" ~ (github_org | lower) ~ ".github.io/" ~ repo_name ~ "/" %}
homepage_url: {{ site if 'docs' in workflows else "https://github.com/" ~ github_org ~ "/" ~ repo_name }}
repository: https://github.com/{{ github_org }}/{{ repo_name }}
schema_url: https://github.com/{{ github_org }}/{{ repo_name }}/blob/main/src/{{ mech_slug }}/schema/{{ mech_slug }}.yaml
{%- if collection in ('monarch', 'xmech') %}
collection:
  - {{ 'x-mech-suite' if collection == 'xmech' else 'monarch' }}
{%- endif %}
domains:
{%- for d in domains %}
  - {{ d }}
{%- endfor %}
{%- if taxon_scope %}
taxon:
{%- for t in taxon_scope.split(',') %}
  - {{ t | trim }}
{%- endfor %}
{%- endif %}
record_type: {{ record_article }} {{ record_noun }}
record_count: 0
record_count_date: {{ '%Y-%m-%d' | strftime }}
record_identifier_policy: >-
{%- if identity_prefix %}
  Records are keyed by {{ identity_prefix }} CURIEs where a term exists and
  otherwise by a minted {{ mech_slug }}:<uuid> CURIE.
{%- else %}
  Records take a stable identifier from a source when one names them
  uniquely, otherwise a minted {{ mech_slug }}:<uuid> CURIE.
{%- endif %}
identifier_prefix: {{ mech_slug }}
{%- set seen = [] %}
{%- if identity_prefix %}{% set _ = seen.append(identity_prefix) %}{% endif %}
{%- for o in ontology_selection if o.prefix not in seen %}{% set _ = seen.append(o.prefix) %}{% endfor %}
ontologies:{% if not seen %} []{% endif %}
{%- for p in seen %}
  - {{ p }}
{%- endfor %}
data_sources:
  - name: PubMed
    url: https://pubmed.ncbi.nlm.nih.gov/
    relation_type: prov:hadPrimarySource
    description: Evidence snippets are verbatim quotes, checked against the cached source.
license:
{%- if data_license == 'CC0-1.0' %}
  id: https://creativecommons.org/publicdomain/zero/1.0/
  label: CC0 1.0
  spdx_id: CC0-1.0
{%- else %}
  id: https://creativecommons.org/licenses/by/4.0/
  label: CC BY 4.0
  spdx_id: CC-BY-4.0
{%- endif %}
code_license:
{%- if code_license == 'BSD-3-Clause' %}
  id: https://opensource.org/license/bsd-3-clause
  label: BSD-3-Clause
{%- elif code_license == 'MIT' %}
  id: https://opensource.org/licenses/MIT
  label: MIT License
{%- else %}
  id: https://www.apache.org/licenses/LICENSE-2.0
  label: Apache License 2.0
{%- endif %}
  spdx_id: {{ code_license }}
curation:
  agent_curated: true
  human_review: pull_request
  agents:
    - Claude Code
  evidence_policy: >-
    Every claim cites a source with a verbatim quote. linkml-reference-validator
    fetches the source and checks that the quote appears in it.
  validation:
    - schema
    - ontology_terms
    - references
  curation_history: true
features:
{%- if causal_graphs %}
  - causal_mechanism_graphs
{%- endif %}
  - evidence_snippets
{%- if seen %}
  - ontology_grounding
{%- endif %}
  - append_only_history
  - knowledge_gaps
{%- if include_site %}
  - static_browser
{%- endif %}
disclaimer: >-
  {{ mech_name }} is AI-curated. Automated validation checks that citations
  exist, quoted snippets are exact, and ontology terms are real. It does not
  check scientific correctness.
contacts:
  - category: Individual
    label: {{ author_name }}
{%- if author_orcid %}
    orcid: {{ author_orcid }}
{%- endif %}
    contact_details:
      - contact_type: email
        value: {{ author_email }}
      - contact_type: github
        value: {{ github_user }}
products:
  - id: {{ mech_slug }}.records
    category: RecordCorpus
    name: {{ record_noun | capitalize }} records
    description: One YAML file per {{ record_noun }} in {{ records_dir }}, validated against the {{ mech_name }} LinkML schema.
    product_url: https://github.com/{{ github_org }}/{{ repo_name }}/tree/main/{{ records_dir }}
    format: yaml
  - id: {{ mech_slug }}.schema
    category: DataModelProduct
    name: {{ mech_name }} LinkML schema
    product_url: https://github.com/{{ github_org }}/{{ repo_name }}/blob/main/src/{{ mech_slug }}/schema/{{ mech_slug }}.yaml
    format: linkml
    compatibility:
      - linkml
      - mech_shared
{%- if 'docs' in workflows %}
  - id: {{ mech_slug }}.docs
    category: DocumentationProduct
    name: {{ mech_name }} documentation
    description: Schema reference generated by LinkML, with the domain and curation guides.
    product_url: {{ site }}
    format: html
{%- if include_site %}
  - id: {{ mech_slug }}.browser
    category: GraphicalInterface
    name: Record browser
    description: A page for every {{ record_noun }} record.
    product_url: {{ site }}records/
    format: html
{%- endif %}
{%- endif %}
{%- if 'release-records' in workflows %}
{#- The export's files, from the latest release. export.py's downloads() and
    registry_products() say the same; the Mech's tests/test_export.py holds
    them equal, and `python -m <slug>.export --registry-products` prints
    them after conf/export.yaml changes. #}
{%- set flat = (tabular_layout | default('per_class')) == 'flat' %}
{%- set kgx_std = ['kgx', 'biolink'] if (kgx_biolink | default(true)) else ['kgx'] %}
{%- set graph_csv = "One file per class, linked by ids, as in the SQL export." %}
{%- set flat_csv = 'One row per record; a list is joined with " | ", and a nested object is written as JSON.' %}
{%- set rows = [
  ['yaml', 'records.zip', 'Records as YAML (zip)', 'The curated YAML files, one per record, as they are.', 'RecordCorpus', 'yaml', 'zip'],
  ['json', 'records.json', 'Records as JSON', 'Every record, in one JSON array.', 'RecordCorpus', 'json', ''],
  ['json', 'records.jsonl', 'Records as JSON Lines', 'One record per line.', 'RecordCorpus', 'jsonl', ''],
  ['jsonld', 'records.jsonld', 'Records as JSON-LD (RDF)', "The records as an RDF graph, through the schema's URIs: the same graph as the Turtle file.", 'GraphProduct', 'jsonld', ''],
  ['ttl', 'records.ttl', 'Records as Turtle (RDF)', "The records as an RDF graph, through the schema's URIs.", 'GraphProduct', 'turtle', ''],
  ['sqlite', 'records.sqlite', 'SQLite database', "One table per class, as gen-sqltables defines them; a nested object's row points at its parent.", 'RecordCorpus', 'sqlite', ''],
  ['duckdb', 'records.duckdb', 'DuckDB database', 'One table of records, with nested values as DuckDB JSON, written through linkml-store.', 'RecordCorpus', 'duckdb', ''],
  ['parquet', 'tables-parquet.zip', 'Tables as Parquet (zip)', 'One Parquet file per class, linked by ids, as in the SQL export.', 'RecordCorpus', 'other', 'zip'],
  ['sql', 'schema.sql', 'Schema as SQL DDL', 'The tables of the SQL export, as gen-sqltables writes them.', 'DataModelProduct', 'sql', ''],
  ['sql', 'records.sql', 'Records as SQL', 'The SQLite database as SQL: its tables and an INSERT per row.', 'RecordCorpus', 'sql', ''],
  ['csv', 'records.csv' if flat else 'tables-csv.zip', 'Records as CSV' if flat else 'Tables as CSV (zip)', flat_csv if flat else graph_csv, 'RecordCorpus', 'csv', '' if flat else 'zip'],
  ['tsv', 'records.tsv' if flat else 'tables-tsv.zip', 'Records as TSV' if flat else 'Tables as TSV (zip)', flat_csv if flat else graph_csv, 'RecordCorpus', 'tsv', '' if flat else 'zip'],
] %}
{%- for fmt, graph, what in [['kgx', 'KGX', 'each record and the terms it binds'], ['kgx_maximal', 'KGX whole-graph', 'every object in the records, linked']] %}
{%- for kind in ['nodes', 'edges'] %}
{%- for ext, serial in [['jsonl', 'JSON Lines'], ['tsv', 'TSV']] %}
{%- set _ = rows.append([fmt, fmt ~ '_' ~ kind ~ '.' ~ ext, graph ~ ' ' ~ kind ~ ' as ' ~ serial, 'The ' ~ kind ~ ' of a KGX graph of ' ~ what ~ '.', 'GraphProduct', 'kgx', '']) %}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- set _ = rows.append(['sssom', 'mappings.sssom.tsv', 'Mappings as SSSOM', "Each record's mappings to identifiers elsewhere, with how each was found: an SSSOM mapping set.", 'MappingProduct', 'sssom', '']) %}
{%- set _ = rows.append(['croissant', 'croissant.json', 'Croissant metadata', 'Croissant (MLCommons) metadata: every file here with its checksum, the records field by field, and where the data came from.', 'OtherProduct', 'jsonld', '']) %}
{%- for fmt, file, label, about, category, format, compression in rows if fmt in output_formats %}
  - id: {{ mech_slug }}.{{ file | replace('.', '-') }}
    category: {{ category }}
    name: {{ label }}
    description: '{{ about | replace("'", "''") }}'
    product_url: https://github.com/{{ github_org }}/{{ repo_name }}/releases/latest/download/{{ mech_slug }}-{{ file }}
    format: {{ format }}
{%- if compression %}
    compression: {{ compression }}
{%- endif %}
{%- if format == 'kgx' %}
    compatibility:
{%- for s in kgx_std %}
      - {{ s }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
cross_references:
  - target: dismech
    relation: follows_pattern_of
creation_date: {{ '%Y-%m-%d' | strftime }}
last_modified_date: {{ '%Y-%m-%d' | strftime }}
---
{{ mech_name }} was created with mechmaker. It holds no records yet.
