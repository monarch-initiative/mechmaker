def test_own_koza_ingest_scaffolds_runs_and_locks(where, monkeypatch):
    monkeypatch.setattr(ingest, "INGESTS_DIR", where / "ingests")
    monkeypatch.setattr(ingest, "REPO_ROOT", where)
    ingest.scaffold("demo_source")
    data = where / "build" / "ingest" / "demo_source" / "data" / "demo_source.tsv"
    data.parent.mkdir(parents=True)
    data.write_text("id\tname\trelated\nX:1\tone\tY:2\nX:2\ttwo\tY:3\n", encoding="utf-8")
    conf = {"kind": "koza", "path": "ingests/demo_source", "sources": ["infores:example"]}
    assert ingest.problems({"demo_source": conf}, {}) == []

    entry = ingest.run_koza("demo_source", conf, None, update=False, fetch=False)
    assert set(entry["outputs"]) == {"demo_source_nodes.tsv", "demo_source_edges.tsv"}
    assert "koza" in entry["tools"]
    ingest.save_lock({"demo_source": entry})
    edges = list(ingest.rows("demo_source", "demo_source_edges.tsv"))
    assert [e["subject"] for e in edges] == ["X:1", "X:2"]
    # Stable ids: the same download makes the same output.
    again = ingest.run_koza("demo_source", conf, entry, update=False, fetch=False)
    assert again["outputs"] == entry["outputs"]

    data.write_text("id\tname\trelated\nX:1\tchanged\tY:2\n", encoding="utf-8")
    with pytest.raises(ingest.IngestError, match="the source changed"):
        ingest.run_koza("demo_source", conf, entry, update=False, fetch=False)
